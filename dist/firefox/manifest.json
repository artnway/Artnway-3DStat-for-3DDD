{
  "name": "3DStat",
  "version": "1.4",
  "manifest_version": 2,
  "description": "Аналитика продаж 3DDD и 3DSky: карточки, графики, топ-модели, диагностика и экспорт в Excel.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "https://3ddd.ru/*",
    "https://3dsky.org/*",
    "https://users.3ddd.ru/*",
    "https://users.3dsky.org/*",
    "https://author-stats.3ddd.ru/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "3DStat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "3dstat@artnway.local",
      "strict_min_version": "115.0"
    }
  }
}
