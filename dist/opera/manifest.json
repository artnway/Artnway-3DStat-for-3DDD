{
  "name": "3DStat",
  "version": "1.3",
  "manifest_version": 3,
  "description": "Аналитика продаж 3DDD и 3DSky: карточки, графики, топ-модели, диагностика и экспорт в Excel.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "webRequest"
  ],
  "host_permissions": [
    "https://3ddd.ru/*",
    "https://3dsky.org/*",
    "https://users.3ddd.ru/*",
    "https://users.3dsky.org/*",
    "https://author-stats.3ddd.ru/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "settings.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "3DStat",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "minimum_chrome_version": "114"
}
